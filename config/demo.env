# ============================================
# demo 环境 — 面向客户演示,用真实模型
# 启动: make demo(演示前在 config.env 或 shell 填入真实 key)
# ============================================

# 真实调用(LLM_MOCK 不生效)
LLM_PROVIDER=openai
LLM_MOCK=false

# 演示前填写(或放 config.env,优先级更高):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# DEFAULT_MODEL=deepseek-chat
