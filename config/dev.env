# ============================================
# dev 环境(默认) — make run / make seed / make db-init 使用
# 优先级: shell env > config.env > 本文件 > 默认值
# ============================================

# LLM Provider: mock | record | replay | openai
#   replay 未命中 fixture 时自动降级 mock(首次开发体验友好)
LLM_PROVIDER=replay

# 本地数据库(compose.local 覆盖 compose.yml 的密码)
DATABASE_URL=postgresql://nexusai:nexusai_local@localhost:5432/nexusai

# Wave A JWT（人侧会话）
JWT_SECRET=nxai-local-jwt-secret-generate-with-secrets-token-urlsafe-48
JWT_TTL_SECONDS=3600

# 密钥放 gitignore 的 config.env（见 TIKHUB_API_KEY），勿写在本文件
