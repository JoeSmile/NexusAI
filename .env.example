# Docker Compose interpolation channel — copy to `.env` next to docker-compose.prod.yml.
# Compose reads THIS file (and the shell). It does NOT read `config.env`.
#
# In-container secrets (JWT, LLM keys, CORS) still live in `config.env`
# (`cp config.env.example config.env`).
#
# Alternative: `set -a && source config.env && set +a` before `docker compose up`
# if you insist on a single file — then `.env` can stay empty, but `${VAR:?}`
# still needs those names exported.
#
# DATABASE_URL in config.env is ignored by prod compose: environment: wins
# and builds postgresql://nexusai:${DB_PASSWORD}@postgres:5432/nexusai

DB_PASSWORD=
REDIS_PASSWORD=

# Optional — LLM slot overrides (code defaults 16 / 8 / 5s)
# LLM_CONCURRENCY_LIMIT=16
# LLM_BUCKET_LIMIT=8
# LLM_CONCURRENCY_ACQUIRE_TIMEOUT_S=5

# Frontend / nginx
# NGINX_CONF=./deploy/nginx.conf
# Langfuse overlay (NOT COMPOSE_PROFILES — Compose interpolates inactive profiles):
#   NGINX_CONF=./deploy/nginx.langfuse.conf
#   docker compose -f docker-compose.prod.yml -f docker-compose.langfuse.yml up -d

# Bind-mount uploads/logs: chown to the image appuser after first start
#   docker compose -f docker-compose.prod.yml exec nexusai id
#   chown -R <uid>:<gid> uploads logs

# --- Langfuse overlay only (`docker-compose.langfuse.yml`; `:?` does not affect default up) ---
# LANGFUSE_ENABLED=true
# LANGFUSE_HOST=http://langfuse-web:3000
# LANGFUSE_BASE_URL=http://langfuse-web:3000
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_S3_PASSWORD=
# NEXTAUTH_SECRET=
# SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_INIT_USER_PASSWORD=
# NEXTAUTH_URL=https://your.example.com/langfuse
# LANGFUSE_S3_MEDIA_PUBLIC_ENDPOINT=https://your.example.com/langfuse-media

# docker-compose.yml Grafana (not prod compose)
# GRAFANA_ADMIN_PASSWORD=
