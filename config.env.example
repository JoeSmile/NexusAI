# ============================================
# NexusAI 配置文件示例
# 复制为 config.env 后按需修改（config.env 已 gitignore）
#
# 加载优先级: shell env > config.env > config/{APP_ENV}.env > 代码默认值
# APP_ENV ∈ {dev, test, demo} → 对应 config/dev.env 等（本地可叠一层）
#
# 写法注意: KEY=value（等号两侧不要空格）
#
# 生产 compose 有两条通道，不要混：
#   1) 项目根 `.env`（复制 `.env.example`）→ Compose 插值 ${DB_PASSWORD} ${REDIS_PASSWORD:?} …
#   2) 本文件复制为 config.env → 容器内 env_file（JWT / LLM / CORS）
# Compose 不读 config.env 做 ${VAR} 替换。environment: 会盖掉 env_file 同名键，
# 因此 config.env 里的 DATABASE_URL 在 prod compose 中无效，只认 `.env` 的 DB_PASSWORD。
# ============================================

# ╔══════════════════════════════════════════╗
# ║ 一、你需要手填的密钥（按场景）              ║
# ╚══════════════════════════════════════════╝
#
# 【社媒对标 Task 52 — 本地要真 probe】必填 1 项:
#   TIKHUB_API_KEY     → https://user.tikhub.io 申请/充值
#
# 【真实 LLM（结构分析 / 复刻 / 对话）】至少填 1 条链路:
#   LLM_PROVIDER=openai|record 时填 LLM_API_KEY（或 OPENAI_API_KEY）
#   若用百炼/通义 embedding 或 qwen-turbo: 再填 QWEN_API_KEY
#   若模型走 DeepSeek 且未用 LLM_API_KEY: 填 DEEPSEEK_API_KEY
#   仅本地假数据: LLM_PROVIDER=mock|replay → 可不填 LLM 钥
#
# 【租户密钥入库加密 Task 18】生产/要测密钥库时必填:
#   LLM_KEY_MASTER_KEY → python -c 'import secrets; print(secrets.token_hex(32))'
#
# 【人侧登录 JWT】本地可用下方占位；上线务必改强随机:
#   JWT_SECRET
#
# 【生产 compose】另见文末「生产专用」——与本地无关时可忽略
#
# 小结（本机跑社媒对标最小集）:
#   1) TIKHUB_API_KEY          ← 必填
#   2) LLM 钥或 LLM_PROVIDER=mock/replay
#   其余 DATABASE/REDIS/JWT 用本文件默认即可（配 docker-compose.local）

# ── Task 52 · TikHub / 社媒 ──
# 必填（真 probe / 拉列表）;留空则 connector 启动失败
TIKHUB_API_KEY=
# 以下均有默认，一般不用改
SOCIAL_TIKHUB_QPS=2
SOCIAL_TIKHUB_BURST=4
SOCIAL_PROBE_MAX_WAIT_S=10
SOCIAL_WORKER_MAX_WAIT_S=60
SOCIAL_RATE_LIMIT_RETRIES=3
SOCIAL_WORKER_POLL_SEC=2.0
SOCIAL_COST_ALERT_USD=3.0
SOCIAL_PRICE_MULTIPLIER=3.0

# ── LLM 密钥（按你选的 provider）──
# LLM_PROVIDER: mock | record | replay | openai
#   replay 未命中 fixture → 降级 mock（本地默认友好）
LLM_PROVIDER=replay
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ── LLM Key 入库主密钥（Task 18；空=无法加密存租户钥）──
# 生成: python -c 'import secrets; print(secrets.token_hex(32))'
LLM_KEY_MASTER_KEY=

# ── Wave A JWT（人侧会话；勿复用 LLM 密钥）──
# 生成: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=nxai-local-jwt-secret-generate-with-secrets-token-urlsafe-48
JWT_TTL_SECONDS=3600

# ╔══════════════════════════════════════════╗
# ║ 二、本地默认可用（照抄即可）                ║
# ╚══════════════════════════════════════════╝

# ── 数据库 / Redis（对齐 docker-compose.local）──
DATABASE_URL=postgresql://nexusai:nexusai_local@localhost:5432/nexusai
DB_TYPE=postgresql
REDIS_URL=redis://:nexusai_redis@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nexusai_redis
# 限流/并发槽专用 Redis（未设则回退 REDIS_URL）。禁止指向 langfuse-redis。生产建议独立实例、关 AOF。
# REDIS_RATELIMIT_URL=redis://:nexusai_redis@localhost:6379/0
# LLM_CONCURRENCY_LIMIT=16
# 显式整数；禁止用 os.cpu_count() 推导（容器常报宿主机核数）。集群总量=该值（Redis 共享）。
# LLM_BUCKET_LIMIT=8
# 桶身份=LLMKey.id（无 id 回退 base_url）。同 provider 多租户互不踩。
# LLM_CONCURRENCY_ACQUIRE_TIMEOUT_S=5
# 超时 → RATE_001 / llm_slot_busy + Retry-After: 2（与租户 QPS 区分）
# LLM_INFLIGHT_TTL_S=1200
# UVICORN_WORKERS=1
# --reload / UVICORN_RELOAD=1 时强制 1 worker。多 worker 须 Redis 槽（切片 2）已落地。
# THREAD_POOL_MAX_WORKERS=10
# 代码默认 10；asyncio.to_thread 与 PerformanceOptimizer 共用。生产阶梯见部署指南（常 64）。
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# 真源 backend/database/pg_pool.py（默认 10+20）。performance_config 的 20+30 无消费者。
# 预算: (DB_POOL_SIZE + DB_MAX_OVERFLOW) × UVICORN_WORKERS + extras < PG max_connections
# 2 workers × (10+20) + memory(30) + social(30) = 120；prod compose 已把 PG max_connections 调到 200。
# 勿把代码默认改成 40+60。
# EMBED_CONCURRENCY_LIMIT=48
# EMBED_BUCKET_LIMIT=8
# EMBED_HTTP_TIMEOUT_S=15

# ── 模型档位 / Registry ──
# 本地 Ollama 示例（OpenAI 兼容口 http://127.0.0.1:11434/v1）:
#   DEFAULT_MODEL / MODEL_* 均指向本机 tag，如 qwen2.5:7b
#   MODEL_REGISTRY_JSON 需包含同名 chat 项；Admin LLM Key 的 allowed_models 也要一致
DEFAULT_MODEL=deepseek-v4-flash
MODEL_CHEAP=qwen-turbo
MODEL_GOOD=deepseek-v4-flash
MODEL_BEST=deepseek-v4-flash
# 单行 JSON；dotenv 同名键只认首行
MODEL_REGISTRY_JSON=[{"name":"qwen-turbo","provider":"qwen","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"QWEN_API_KEY","capability":"chat","tier":"cheap","cost_per_1k":0.00005,"max_tokens":4096},{"name":"text-embedding-v3","provider":"qwen","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"QWEN_API_KEY","capability":"embedding","tier":"cheap","cost_per_1k":0.0001,"max_tokens":0},{"name":"qwen-vl-plus","provider":"qwen","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"QWEN_API_KEY","capability":"vision","tier":"cheap","cost_per_1k":0.0008,"max_tokens":2048}]

# ── Embedding (Task 28)；不设 EMBEDDING_API_KEY 时回落 QWEN_API_KEY / LLM_API_KEY ──
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=768
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=

# ── 环境分层 ──
# APP_ENV=dev

# ── Capability Hub (Task 30.03) ──
CAPABILITY_REGISTRY_JSON=[]
CAP_QUOTA_DAILY_CALLS=1000
CAP_QUOTA_DAILY_COST_USD=10.0
CAP_RATE_LIMIT_PER_MIN=60
# Chat 管线租户 QPS（分钟桶，跨 worker/pod 共享 Redis）。0=关。默认 600≈旧 TokenBucket 10/s
# CHAT_RATE_LIMIT_PER_MIN=600
# Task 56 — 面试演示：stream 路径也跑 task_plan（默认关；会阻塞首 token，优先用下方异步）
# FORCE_TASK_PLAN_ON_STREAM=1
# ORCHESTRATOR_ENABLED=false
# Task 70 — 流式异步规划（不阻塞图；SSE 先发 pending，≤TIMEOUT 后 done/降级直答）
# ASYNC_TASK_PLAN_ON_STREAM=1
# TASK_PLAN_TIMEOUT_S=8
# ORCHESTRATOR_MAX_WORKERS=8
# ORCHESTRATOR_MAX_DEPTH=3
# ORCHESTRATOR_MAX_SPAWN_TOTAL=32
# TOOL_SEARCH_HYBRID_ENABLED=1
# TOOL_SEARCH_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# TOOL_SEARCH_EMBED_MODEL_PATH=D:/LLMs/benchmarks/models/bge-small-zh-v1.5
# TOOL_SEARCH_FALLBACK_IDS=skill:weather,model:chat
# MEMORY_DUAL_MODE_ENABLED=1
# BLACKBOARD_MAX_ENTRIES=32
# BLACKBOARD_TTL_S=3600
# RAG_SANITIZE_MAX_FRAGMENT_CHARS=2000
# LOOP_GUARD_ENABLED=1
# LOOP_GUARD_MAX_DUP_STREAK=3
# LOOP_GUARD_SESSION_CAP=50
# CAPABILITY_UPSTREAM_MOCK=true
# DIFY_API_KEY=
# COZE_API_KEY=

# ── RAG ──
RAG_HYDE_ENABLED=false
RAG_RERANK_ENABLED=false
RAG_RERANK_POOL_SIZE=20
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_ANSWER=3600
RAG_CACHE_TTL_EMBED=86400
RAG_RATE_LIMIT_REQ=60
RAG_RATE_LIMIT_MISS=10

# ── LangFuse OSS v4（默认关）──
# 需要时: docker compose -f docker-compose.prod.yml -f docker-compose.langfuse.yml
#   且 NGINX_CONF=./deploy/nginx.langfuse.conf 且 LANGFUSE_ENABLED=true
# 本地: COMPOSE_PROFILES=langfuse docker compose -f docker-compose.local.yml up
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-nexusai
LANGFUSE_SECRET_KEY=sk-lf-local-nexusai
LANGFUSE_SAMPLE_SHORT_PATH=0.1
LANGFUSE_SAMPLE_LONG_PATH=1.0

# ── Key 故障转移（Task 27）──
KEY_COOLDOWN_SECONDS=60
KEY_MAX_CONSECUTIVE_FAILURES=3

# ── 服务器 ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# 本地开发可开；生产 compose 会覆盖为 false，且 ENVIRONMENT=production 时启动自检拒绝 true
# 本地开发：CORS_ALLOW_ALL=true 时 credentials 自动关闭（禁止 *+credentials）
# 前后端分离时请改为 false 并设置 CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL=true
UPLOAD_DIR=./uploads

# ╔══════════════════════════════════════════╗
# ║ 三、生产专用（本地可忽略）                  ║
# ╚══════════════════════════════════════════╝
# ENVIRONMENT=production
# CORS_ALLOW_ALL=false
# CORS_ALLOW_ORIGINS=https://app.example.com
# LLM_PROVIDER=openai
# USE_SQLITE_FALLBACK=0          # prod compose 已写死 0；PG 挂了不要静默写容器内 SQLite
# 生成强密钥（各跑一次，勿复用；弱密钥 → production_guard 失败 → restart: always 空转，先看 API 日志）:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=                    # ≥32 随机
# JWT_SECRET=
# SALT=                         # 仅开 Langfuse 时必填（≥32，非 change-me）
# LLM_KEY_MASTER_KEY=           # python -c "import secrets; print(secrets.token_hex(32))"
# AUDIT_ENCRYPTION_ENABLED=1    # Task 59 S4：审计 input/output 加密（opt-in）
# AUDIT_ENCRYPTION_KEY=         # python -c "import secrets; print(secrets.token_hex(32))"
# DB_PASSWORD=                  # 放项目根 `.env`（Compose 插值），不是只写在这里
# REDIS_PASSWORD=               # 同上
# NEXTAUTH_SECRET=
# LANGFUSE_ENCRYPTION_KEY=      # openssl rand -hex 32
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_S3_PASSWORD=
# LANGFUSE_INIT_USER_PASSWORD=
# NEXTAUTH_URL=https://nexusai.example.com/langfuse
# LANGFUSE_S3_MEDIA_PUBLIC_ENDPOINT=https://nexusai.example.com/langfuse-media
# 前端：Node >= 20.19（Vite 8）+ pnpm；发布用 rsync -a --delete，不要 scp 整个 dist 目录
# 证书：bash deploy/ssl/gen-self-signed.sh 或 ACME；pem 不入库
# 意图模型：拷到 data/models/intent_v8/ 再 up（空目录 bind = 静默规则兜底）
