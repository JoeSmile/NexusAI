# ============================================
# ContextGate 配置文件示例
# 复制为 config.env 后按需修改（config.env 已 gitignore）
# ============================================

# ── 数据库 ──
DATABASE_URL=postgresql://contextgate:contextgate_local@localhost:5432/contextgate
DB_TYPE=postgresql

# ── LLM ──
# LLM_PROVIDER: mock(确定性伪响应) | record(真实调用+落盘fixture) | replay(回放fixture,未命中降级mock) | openai(始终真实)
# 未设置时兼容旧 LLM_MOCK:true→mock,false→openai
LLM_PROVIDER=replay
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-v4-flash
MODEL_CHEAP=qwen-turbo
MODEL_GOOD=deepseek-v4-flash
MODEL_BEST=deepseek-v4-flash
# 分层: 小模型档=qwen-turbo(百炼),大模型档=deepseek-v4-flash。
# 两家端点不同,per-model base_url 由 MODEL_REGISTRY_JSON 提供(按 name 覆盖):
# 单行 JSON 数组(dotenv 同名键只认首行);chat + embedding + 可选本地模型写在一起:
MODEL_REGISTRY_JSON=[{"name":"qwen-turbo","provider":"qwen","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"QWEN_API_KEY","capability":"chat","tier":"cheap","cost_per_1k":0.00005,"max_tokens":4096},{"name":"text-embedding-v3","provider":"qwen","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_ref":"QWEN_API_KEY","capability":"embedding","tier":"cheap","cost_per_1k":0.0001,"max_tokens":0}]
# 密钥按 provider 分列(QWEN_API_KEY / DEEPSEEK_API_KEY),也可经 KeyManager 加密入库
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=

# ── Embedding (Task 28) ──
# RAG/记忆向量走 DashScope text-embedding-v3;不设 EMBEDDING_API_KEY 时用 QWEN_API_KEY
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=768
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=

# 环境分层:APP_ENV ∈ {dev, test, demo},对应加载 config/{APP_ENV}.env
# 优先级: shell env > config.env > config/{APP_ENV}.env > 默认值
# APP_ENV=dev

# ── ModelRegistry (Task 21.01) ──
# MODEL_CHEAP / MODEL_GOOD / MODEL_BEST 仍可用；额外模型追加进上方同一 JSON 数组,勿再写第二行 MODEL_REGISTRY_JSON
# 例: ...,{"name":"local-7b","provider":"vllm","base_url":"http://localhost:8001/v1","tier":"best","cost_per_1k":0,"max_tokens":2048}]

# ── RAG Deepening (Task 20.01) ──
RAG_HYDE_ENABLED=false
RAG_RERANK_ENABLED=false
RAG_RERANK_POOL_SIZE=20

# ── RAG Cache (Task 29) ──
# Redis: compose redis-stack 默认如下;生产请改 REDIS_URL
REDIS_URL=redis://localhost:6379
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_ANSWER=3600
RAG_CACHE_TTL_EMBED=86400
RAG_RATE_LIMIT_REQ=60
RAG_RATE_LIMIT_MISS=10

# ── LangFuse（本地 compose 用 langfuse:2 + 自动 seed 的 key）──
# UI: http://localhost:3001  账号 admin@contextgate.local / contextgate
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-contextgate
LANGFUSE_SECRET_KEY=sk-lf-local-contextgate
# 短路径(skill/cache) 采样率 / 长路径(LLM) 采样率
LANGFUSE_SAMPLE_SHORT_PATH=0.1
LANGFUSE_SAMPLE_LONG_PATH=1.0

# ── LLM Key 治理（Task 18）──
# 生成: python -c 'import secrets; print(secrets.token_hex(32))'
LLM_KEY_MASTER_KEY=

# ── LLM Key 故障转移（Task 27）──
# 冷却秒数(429/401 后暂不选用);连续失败达阈值则 is_active=false
KEY_COOLDOWN_SECONDS=60
KEY_MAX_CONSECUTIVE_FAILURES=3

# ── 服务器 ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOW_ALL=true
UPLOAD_DIR=./uploads

# ── 生产 compose 额外变量（docker-compose.prod.yml）──
# DB_PASSWORD=change-me
# NEXTAUTH_SECRET=change-me
# SALT=change-me
# LANGFUSE_ENCRYPTION_KEY=  # openssl rand -hex 32
# LANGFUSE_INIT_USER_PASSWORD=change-me
# NEXTAUTH_URL=https://contextgate.example.com/langfuse
