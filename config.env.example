# ============================================
# ContextGate 配置文件示例
# 复制为 config.env 后按需修改（config.env 已 gitignore）
# ============================================

# ── 数据库 ──
DATABASE_URL=postgresql://contextgate:contextgate_local@localhost:5432/contextgate
DB_TYPE=postgresql

# ── LLM ──
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat
MODEL_CHEAP=deepseek-chat
MODEL_GOOD=deepseek-chat
MODEL_BEST=deepseek-chat

# ── LangFuse ──
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-local-dev
LANGFUSE_SECRET_KEY=sk-local-dev

# ── LLM Key 治理（Task 18）──
# LLM_KEY_MASTER_KEY=<python -c 'import secrets; print(secrets.token_hex(32))'>

# ── 服务器 ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOW_ALL=true
UPLOAD_DIR=./uploads

# ── 生产 compose 额外变量（docker-compose.prod.yml）──
# DB_PASSWORD=change-me
# NEXTAUTH_SECRET=change-me
# SALT=change-me
# NEXTAUTH_URL=https://contextgate.example.com/langfuse
