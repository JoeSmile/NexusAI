# ============================================
# ContextGate 配置文件示例
# 复制为 config.env 后按需修改（config.env 已 gitignore）
# ============================================

# ── 数据库 ──
DATABASE_URL=postgresql://contextgate:contextgate_local@localhost:5432/contextgate
DB_TYPE=postgresql

# ── LLM ──
# LLM_PROVIDER: mock(确定性伪响应) | record(真实调用+落盘fixture) | replay(回放fixture,未命中降级mock) | openai(始终真实)
# 未设置时兼容旧 LLM_MOCK:true→mock,false→openai
LLM_PROVIDER=replay
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat
MODEL_CHEAP=deepseek-chat
MODEL_GOOD=deepseek-chat
MODEL_BEST=deepseek-chat

# 环境分层:APP_ENV ∈ {dev, test, demo},对应加载 config/{APP_ENV}.env
# 优先级: shell env > config.env > config/{APP_ENV}.env > 默认值
# APP_ENV=dev

# ── ModelRegistry (Task 21.01) ──
# MODEL_CHEAP / MODEL_GOOD / MODEL_BEST 仍可用；额外模型用 JSON 注册：
# MODEL_REGISTRY_JSON=[{"name":"local-7b","provider":"vllm","base_url":"http://localhost:8001/v1","tier":"best","cost_per_1k":0,"max_tokens":2048}]

# ── RAG Deepening (Task 20.01) ──
RAG_HYDE_ENABLED=false
RAG_RERANK_ENABLED=false
RAG_RERANK_POOL_SIZE=20

# ── LangFuse（本地 compose 用 langfuse:2 + 自动 seed 的 key）──
# UI: http://localhost:3001  账号 admin@contextgate.local / contextgate
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-contextgate
LANGFUSE_SECRET_KEY=sk-lf-local-contextgate
# 短路径(skill/cache) 采样率 / 长路径(LLM) 采样率
LANGFUSE_SAMPLE_SHORT_PATH=0.1
LANGFUSE_SAMPLE_LONG_PATH=1.0

# ── LLM Key 治理（Task 18）──
# 生成: python -c 'import secrets; print(secrets.token_hex(32))'
LLM_KEY_MASTER_KEY=

# ── 服务器 ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOW_ALL=true
UPLOAD_DIR=./uploads

# ── 生产 compose 额外变量（docker-compose.prod.yml）──
# DB_PASSWORD=change-me
# NEXTAUTH_SECRET=change-me
# SALT=change-me
# LANGFUSE_ENCRYPTION_KEY=  # openssl rand -hex 32
# LANGFUSE_INIT_USER_PASSWORD=change-me
# NEXTAUTH_URL=https://contextgate.example.com/langfuse
